PLUGIN_DIR = Path(os.environ.get("AGENT_PORTAL_PLUGIN_DIR", Path(__file__).resolve().parents[1]))
VIEWER_DIR = PLUGIN_DIR / "static" / "kicad-viewer"
RUNTIME_DIR = PLUGIN_DIR / ".runtime"
KICAD_RUNTIME_DIR = RUNTIME_DIR / "kicad"
KICAD_STABLE_INDEX = "https://downloads.kicad.org/kicad/linux/explore/stable/"
KICAD_FALLBACK_URL = f"{KICAD_STABLE_INDEX}download/kicad-10.0.6-x86_64.AppImage.tar"
TABS = [

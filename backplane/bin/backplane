left:18px}}details.raw{{margin-top:12px}}details.raw summary{{cursor:pointer;color:#7dcfff}}
</style></head><body>
<header><h1>Backplane PCB Workbench</h1><div class="muted">Session {html.escape(session or "unknown")} · {html.escape(str(cwd))}</div></header>
<nav class="tabs" role="tablist">{buttons}</nav><main>
<section id="overview"><div class="grid"><div class="card"><h2>Project</h2><pre>{html.escape(json.dumps(data, indent=2))}</pre></div><div class="card"><h2>Warnings</h2><ul>{warnings or "<li>None</li>"}</ul></div></div></section>
<section id="schematic"><div class="card"><h2>Schematic</h2><ul>{file_list(by_kind.get("schematic"), "No schematics found.")}</ul>{native_viewer("schematic")}</div></section>
<section id="pcb"><div class="card"><h2>PCB</h2><ul>{file_list(by_kind.get("pcb"), "No boards found.")}</ul>{native_viewer("pcb")}</div></section>

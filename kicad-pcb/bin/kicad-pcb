def usage() -> int:
    print(
        """kicad-pcb portal plugin

Commands:
  setup [--install-kicad] [--install-kicad-tools] [--force]
  doctor [--json] [--cwd PATH]
  serve --port PORT [--cwd PATH] [--session UUID]
  drc [--json] [--cwd PATH]
  erc [--json] [--cwd PATH]
  export gerbers --out PATH [--cwd PATH]
  export jlcpcb --out PATH [--cwd PATH]
  kct [--json] [--cwd PATH] -- <kct arguments...>
  tool [--json] [--cwd PATH] -- <kct|kicad-cli|kikit> <arguments...>
""",
        end="",
    )
    return 2


def parse_cwd(args: list[str]) -> tuple[Path, bool]:
    cwd = Path.cwd()
    as_json = False
    i = 0
    while i < len(args):
        if args[i] == "--json":
            as_json = True
        elif args[i] == "--cwd":
            i += 1
            cwd = Path(args[i]).expanduser()
        i += 1
    return cwd.resolve(), as_json


def kicad_cli() -> str | None:
    managed = managed_kicad_cli()
    return (
        os.environ.get("KICAD_PCB_KICAD_CLI")
        or os.environ.get("BACKPLANE_KICAD_CLI")
        or os.environ.get("KICAD_CLI")
        or managed
        or shutil.which("kicad-cli")
    )


def kct_cli() -> str | None:
    managed = managed_kct_cli()
    return os.environ.get("KICAD_PCB_KCT") or managed or shutil.which("kct") or shutil.which("kicad-tools")


def resolve_tool(name: str) -> str | None:
    if name in {"kct", "kicad-tools"}:
        return kct_cli()
    if name == "kicad-cli":
        return kicad_cli()
    if name == "kikit":
        return shutil.which("kikit")
    return None


def parse_passthrough(rest: list[str]) -> tuple[Path, bool, list[str]]:
    cwd, as_json = parse_cwd(rest)
    if "--" in rest:
        return cwd, as_json, rest[rest.index("--") + 1 :]
    pass_args = []
    skip_next = False
    for item in rest:
        if skip_next:
            skip_next = False
            continue
        if item == "--json":
            continue
        if item == "--cwd":
            skip_next = True
            continue
        pass_args.append(item)
    return cwd, as_json, pass_args


def managed_kct_cli() -> str | None:
    bin_name = "kct.exe" if sys.platform == "win32" else "kct"
    candidates = [
        KCT_RUNTIME_DIR / "bin" / bin_name,
        KCT_RUNTIME_DIR / "Scripts" / bin_name,
    ]
    for candidate in candidates:
        if candidate.exists() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def managed_kicad_cli() -> str | None:
    current = KICAD_RUNTIME_DIR / "current"
    candidates = [
        current / "squashfs-root" / "usr" / "bin" / "kicad-cli",
        current / "usr" / "bin" / "kicad-cli",
        current / "kicad-cli",
    ]
    for candidate in candidates:
        if candidate.exists() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def python3() -> str | None:
    return shutil.which("python3") or shutil.which("python")


def tool_version(tool: str | None) -> str | None:
    if not tool:
        return None
    code, stdout, stderr = run([tool, "--version"], Path.cwd())
    if code != 0:
        return None
    return (stdout or stderr).strip().splitlines()[0] if (stdout or stderr).strip() else None


def kct_version() -> str | None:
    tool = kct_cli()
    if not tool:
        return None
    code, stdout, stderr = run([tool, "--version"], Path.cwd())
    if code != 0:
        return None
    return (stdout or stderr).strip().splitlines()[0] if (stdout or stderr).strip() else None


def kicad_tools_package(extra: str) -> str:
    if extra in {"", "base", "none"}:
        return "kicad-tools"
    if extra == "agent":
        return "kicad-tools[placement,parts,datasheet,report,native]"
    return f"kicad-tools[{extra}]"


def install_kicad_tools_runtime(force: bool = False, extra: str = "agent") -> dict:
    py = python3()
    if not py:
        return {"ok": False, "message": "Python 3 is required to install kicad-tools."}
    if force and KCT_RUNTIME_DIR.exists():
        backup = KCT_RUNTIME_DIR.with_name(f"{KCT_RUNTIME_DIR.name}.old-{int(time.time())}")
        KCT_RUNTIME_DIR.rename(backup)
    if not KCT_RUNTIME_DIR.exists():
        code, stdout, stderr = run([py, "-m", "venv", str(KCT_RUNTIME_DIR)], PLUGIN_DIR)
        if code != 0:
            return {"ok": False, "message": "Failed to create kicad-tools virtualenv.", "stdout": stdout, "stderr": stderr}
    pip = KCT_RUNTIME_DIR / ("Scripts" if sys.platform == "win32" else "bin") / "pip"
    package = kicad_tools_package(extra)
    logs = []
    for command in (
        [str(pip), "install", "--upgrade", "pip"],
        [str(pip), "install", "--upgrade", package],
    ):
        code, stdout, stderr = run(command, PLUGIN_DIR)
        logs.append({"command": command, "code": code, "stdout": stdout[-4000:], "stderr": stderr[-4000:]})
        if code != 0:
            return {"ok": False, "message": f"Failed to install {package}.", "logs": logs}
    return {
        "ok": kct_cli() is not None,
        "package": package,
        "kct": kct_cli(),
        "version": kct_version(),
        "runtime_dir": str(KCT_RUNTIME_DIR),
        "logs": logs,
    }


def fetch_text(url: str) -> str:
    request = urllib.request.Request(url, headers={"User-Agent": "agent-portal-kicad-pcb/1.0"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read().decode("utf-8", "ignore")


def version_key(version: str) -> tuple[int, ...]:
    return tuple(int(part) for part in re.findall(r"\d+", version))


def discover_kicad_appimage_url() -> tuple[str, str]:
    try:
        page = fetch_text(KICAD_STABLE_INDEX)
        matches = []
        for match in re.finditer(r'href="([^"]*kicad-([0-9][^"/]*)-x86_64\.AppImage\.tar)"', page):
            url, version = match.group(1), match.group(2)
            if "-rc" in version or "-lite" in url:
                continue
            if url.startswith("/"):
                url = f"https://downloads.kicad.org{url}"
            elif not url.startswith("http"):
                url = f"{KICAD_STABLE_INDEX.rstrip('/')}/{url}"
            matches.append((version_key(version), version, url))
        if matches:
            _key, version, url = sorted(matches)[-1]
            return version, url
    except Exception:
        pass
    return "10.0.6", KICAD_FALLBACK_URL


def safe_extract_tar(archive: Path, dest: Path) -> None:
    with tarfile.open(archive) as tar:
        dest_resolved = dest.resolve()
        for member in tar.getmembers():
            target = (dest / member.name).resolve()
            target.relative_to(dest_resolved)
        tar.extractall(dest)


def install_kicad_runtime(force: bool = False) -> dict:
    if sys.platform != "linux":
        return {
            "ok": False,
            "message": "Managed KiCad runtime install currently supports Linux AppImage hosts only.",
            "platform": sys.platform,
        }
    if os.uname().machine not in ("x86_64", "amd64"):
        return install_kicad_ubuntu_ppa()

    version, url = discover_kicad_appimage_url()
    install_dir = KICAD_RUNTIME_DIR / "versions" / version
    cli = install_dir / "squashfs-root" / "usr" / "bin" / "kicad-cli"
    current = KICAD_RUNTIME_DIR / "current"
    if cli.exists() and not force:
        current.parent.mkdir(parents=True, exist_ok=True)
        if current.exists() or current.is_symlink():
            current.unlink()
        current.symlink_to(install_dir, target_is_directory=True)
        return {"ok": True, "version": version, "url": url, "kicad_cli": str(cli), "reused": True}

    KICAD_RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="kicad-pcb-kicad-", dir=KICAD_RUNTIME_DIR) as tmp_name:
        tmp = Path(tmp_name)
        archive = tmp / "kicad.AppImage.tar"
        request = urllib.request.Request(url, headers={"User-Agent": "agent-portal-kicad-pcb/1.0"})
        with urllib.request.urlopen(request, timeout=600) as response, archive.open("wb") as handle:
            shutil.copyfileobj(response, handle)
        safe_extract_tar(archive, tmp)
        appimages = sorted(tmp.glob("*.AppImage"))
        if not appimages:
            appimages = sorted(tmp.rglob("*.AppImage"))
        if not appimages:
            return {"ok": False, "message": "KiCad AppImage tar did not contain an AppImage.", "url": url}
        appimage = appimages[0]
        appimage.chmod(appimage.stat().st_mode | 0o755)
        extract_root = tmp / "extract"
        extract_root.mkdir()
        code, stdout, stderr = run([str(appimage), "--appimage-extract"], extract_root)
        if code != 0:
            return {"ok": False, "message": "KiCad AppImage extraction failed.", "stdout": stdout, "stderr": stderr, "url": url}
        extracted_cli = extract_root / "squashfs-root" / "usr" / "bin" / "kicad-cli"
        if not extracted_cli.exists():
            return {"ok": False, "message": "Extracted KiCad runtime did not include usr/bin/kicad-cli.", "url": url}
        if install_dir.exists() and force:
            backup = install_dir.with_name(f"{install_dir.name}.old-{int(time.time())}")
            install_dir.rename(backup)
        install_dir.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(extract_root / "squashfs-root"), str(install_dir / "squashfs-root"))

    if current.exists() or current.is_symlink():
        current.unlink()
    current.symlink_to(install_dir, target_is_directory=True)
    return {"ok": True, "version": version, "url": url, "kicad_cli": str(cli), "reused": False}


def os_release() -> dict[str, str]:
    data = {}
    path = Path("/etc/os-release")
    if not path.exists():
        return data
    for line in path.read_text().splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key] = value.strip().strip('"')
    return data


def can_sudo() -> bool:
    return shutil.which("sudo") is not None and run(["sudo", "-n", "true"], Path.cwd())[0] == 0


def install_kicad_ubuntu_ppa() -> dict:
    release = os_release()
    if release.get("ID") != "ubuntu":
        return {
            "ok": False,
            "message": "No official KiCad AppImage exists for this Linux architecture. Install KiCad 10 with your distribution package manager or set KICAD_PCB_KICAD_CLI.",
            "machine": os.uname().machine,
            "os": release,
        }
    if not (shutil.which("apt-get") and shutil.which("add-apt-repository")):
        return {
            "ok": False,
            "message": "Ubuntu KiCad 10 install requires apt-get and add-apt-repository.",
            "machine": os.uname().machine,
            "os": release,
        }
    if not can_sudo():
        return {
            "ok": False,
            "message": "Ubuntu KiCad 10 install requires passwordless sudo for noninteractive setup.",
            "commands": [
                "sudo add-apt-repository --yes ppa:kicad/kicad-10.0-releases",
                "sudo apt-get update",
                "sudo apt-get install --yes --install-recommends kicad",
            ],
        }
    commands = [
        ["sudo", "add-apt-repository", "--yes", "ppa:kicad/kicad-10.0-releases"],
        ["sudo", "apt-get", "update"],
        ["sudo", "apt-get", "install", "--yes", "--install-recommends", "kicad"],
    ]
    logs = []
    for command in commands:
        code, stdout, stderr = run(command, Path.cwd())
        logs.append({"command": command, "code": code, "stdout": stdout[-4000:], "stderr": stderr[-4000:]})
        if code != 0:
            return {"ok": False, "message": "KiCad 10 PPA install failed.", "logs": logs}
    return {
        "ok": True,
        "method": "ubuntu-ppa",
        "ppa": "ppa:kicad/kicad-10.0-releases",
        "kicad_cli": kicad_cli(),
        "kicad_version": tool_version(kicad_cli()),
        "logs": logs,
    }


def project_config(cwd: Path) -> dict:
    path = cwd / ".kicad-pcb.json"
    if not path.exists():
        path = cwd / ".backplane.json"
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
        return data if isinstance(data, dict) else {}
    except Exception as exc:
        return {"_warning": f"Could not parse {path.name}: {exc}"}


def safe_rel(cwd: Path, path: str) -> Path:
    candidate = (cwd / unquote(path)).resolve()
    candidate.relative_to(cwd)
    return candidate


def is_project_file(cwd: Path, path: Path, *, active_source: bool = False) -> bool:
    try:
        rel = path.relative_to(cwd)
    except ValueError:
        return False
    ignored = ACTIVE_SOURCE_IGNORED_PARTS if active_source else DISCOVERY_IGNORED_PARTS
    if any(part in ignored for part in rel.parts):
        return False
    lower_name = path.name.lower()
    return not lower_name.endswith(IGNORED_SUFFIXES)


def detect_files(cwd: Path) -> list[dict]:
    files: list[dict] = []
    for path in cwd.rglob("*"):
        if not path.is_file() or not is_project_file(cwd, path):
            continue
        kind = KINDS.get(path.suffix.lower())
        if not kind:
            continue
        stat = path.stat()
        files.append(
            {
                "path": path.relative_to(cwd).as_posix(),
                "kind": kind,
                "mimeType": mimetypes.guess_type(path.name)[0] or "application/octet-stream",
                "size": stat.st_size,
                "mtimeMs": int(stat.st_mtime * 1000),
            }
        )
    return sorted(files, key=lambda item: (item["kind"], item["path"]))


def kicad_sources(cwd: Path) -> list[dict]:
    suffixes = {".kicad_pro", ".kicad_pcb", ".kicad_sch", ".kicad_sym", ".kicad_mod", ".kicad_wks"}
    table_names = {"fp-lib-table", "sym-lib-table"}
    sources = []
    for path in cwd.rglob("*"):
        if (
            path.is_file()
            and (path.suffix.lower() in suffixes or path.name in table_names)
            and is_project_file(cwd, path, active_source=True)
        ):
            sources.append(
                {
                    "filename": path.relative_to(cwd).as_posix(),
                    "content": path.read_text(errors="replace"),
                }
            )
    return sorted(sources, key=lambda item: item["filename"])


def kicad_sources_revision(cwd: Path, sources: list[dict]) -> str:
    latest_mtime = int(max(((cwd / item["filename"]).stat().st_mtime for item in sources), default=time.time()) * 1000)
    digest = hashlib.sha256()
    for item in sources:
        digest.update(item["filename"].encode())
        digest.update(b"\0")
        digest.update(str(len(item["content"])).encode())
        digest.update(b"\0")
    return f"{latest_mtime}-{digest.hexdigest()[:12]}"


def cache_dir_for(cwd: Path) -> Path:
    digest = hashlib.sha256(str(cwd).encode()).hexdigest()[:16]
    return CACHE_DIR / digest


def warm_viewer_state(cwd: Path) -> dict:
    sources = kicad_sources(cwd)
    revision = kicad_sources_revision(cwd, sources)
    data = manifest(cwd)
    data["source_revision"] = revision
    cache_dir = cache_dir_for(cwd)
    cache_dir.mkdir(parents=True, exist_ok=True)

    model_path = cache_dir / f"{revision}.glb"
    model_result: dict | None = None
    if not model_path.exists():
        code, result = export_glb(cwd, model_path)
        model_result = result
        if code != 0 and model_path.exists():
            model_path.unlink()
    else:
        model_result = {"ok": True, "out": str(model_path), "cached": True}

    return {
        "manifest": data,
        "sources": sources,
        "source_revision": revision,
        "model_path": str(model_path) if model_path.exists() else None,
        "model_result": model_result,
        "warmed_at_ms": int(time.time() * 1000),
    }


def current_source_revision(cwd: Path) -> str:
    return kicad_sources_revision(cwd, kicad_sources(cwd))


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def viewer_asset_status() -> dict:
    upstream = os.environ.get("KICAD_PCB_UPSTREAM_VIEWER_DIR") or os.environ.get("BACKPLANE_UPSTREAM_VIEWER_DIR")
    upstream_dir = Path(upstream).expanduser() if upstream else Path.home() / "repos" / "Backplane" / "apps" / "web" / "public" / "kicad-viewer"
    if not VIEWER_DIR.exists():
        return {"ok": False, "message": "Bundled KiCad viewer assets are missing.", "bundled": str(VIEWER_DIR)}
    if not upstream_dir.exists():
        return {
            "ok": None,
            "message": "No upstream KiCad viewer checkout found; set KICAD_PCB_UPSTREAM_VIEWER_DIR to enable drift checks.",
            "bundled": str(VIEWER_DIR),
            "upstream": str(upstream_dir),
        }
    bundled = {path.relative_to(VIEWER_DIR).as_posix(): path for path in VIEWER_DIR.rglob("*") if path.is_file()}
    upstream_files = {path.relative_to(upstream_dir).as_posix(): path for path in upstream_dir.rglob("*") if path.is_file()}
    missing = sorted(set(upstream_files) - set(bundled))
    extra = sorted(set(bundled) - set(upstream_files))
    changed = sorted(
        rel
        for rel in set(bundled) & set(upstream_files)
        if bundled[rel].stat().st_size != upstream_files[rel].stat().st_size
        or file_sha256(bundled[rel]) != file_sha256(upstream_files[rel])
    )
    return {
        "ok": not missing and not extra and not changed,
        "bundled": str(VIEWER_DIR),
        "upstream": str(upstream_dir),
        "missing": missing,
        "extra": extra,
        "changed": changed,
        "file_count": len(bundled),
    }


def manifest(cwd: Path) -> dict:
    config = project_config(cwd)
    warnings = []
    if "_warning" in config:
        warnings.append(config.pop("_warning"))
    cli = kicad_cli()
    if not cli:
        warnings.append("kicad-cli is not available; DRC/ERC/export/BOM/3D generation are disabled.")
    return {
        "root": str(cwd),
        "revision": str(int(time.time())),
        "files": detect_files(cwd),
        "config": config,
        "warnings": warnings,
        "kicad_cli": cli,
        "kicad_version": tool_version(cli),
    }


def run(cmd: list[str], cwd: Path) -> tuple[int, str, str]:
    proc = subprocess.run(cmd, cwd=cwd, text=True, capture_output=True, check=False)
    return proc.returncode, proc.stdout, proc.stderr


def cli_supports(cli: str, args: list[str], needle: str) -> bool:
    code, stdout, stderr = run([cli, *args, "--help"], Path.cwd())
    return code == 0 and needle in f"{stdout}\n{stderr}"


def pick_one(cwd: Path, suffix: str) -> Path | None:
    config = project_config(cwd)
    configured = config.get("pcb" if suffix == ".kicad_pcb" else "schematic")
    if isinstance(configured, str):
        path = (cwd / configured).resolve()
        if path.exists():
            return path
    matches = sorted(path for path in cwd.rglob(f"*{suffix}") if is_project_file(cwd, path, active_source=True))
    return matches[0] if len(matches) == 1 else None


def run_check(cwd: Path, kind: str) -> tuple[int, dict]:
    cli = kicad_cli()
    if not cli:
        return 1, {"ok": False, "message": "kicad-cli is required", "tool": None}
    if kind == "drc":
        if not cli_supports(cli, ["pcb"], "drc"):
            return 1, {
                "ok": False,
                "message": "This kicad-cli does not support PCB DRC. Run `bin/kicad-pcb setup --install-kicad` to install the current KiCad runtime.",
                "tool": cli,
            }
        source = pick_one(cwd, ".kicad_pcb")
        if not source:
            return 1, {"ok": False, "message": "Select a single .kicad_pcb or set pcb in .kicad-pcb.json"}
        with tempfile.TemporaryDirectory(prefix="kicad-pcb-drc-") as tmp:
            out = Path(tmp) / "drc.json"
            command = [cli, "pcb", "drc", "--format", "json", "--output", str(out)]
            if cli_supports(cli, ["pcb", "drc"], "--exit-code-violations"):
                command.append("--exit-code-violations")
            if cli_supports(cli, ["pcb", "drc"], "--schematic-parity"):
                command.append("--schematic-parity")
            command.append(str(source))
            code, stdout, stderr = run(command, cwd)
            return code, {
                "ok": code == 0,
                "source": source.relative_to(cwd).as_posix(),
                "command": command,
                "stdout": stdout,
                "stderr": stderr,
                "report": out.read_text() if out.exists() else "",
            }
    if not cli_supports(cli, ["sch"], "erc"):
        return 1, {
            "ok": False,
            "message": "This kicad-cli does not support schematic ERC. Run `bin/kicad-pcb setup --install-kicad` to install the current KiCad runtime.",
            "tool": cli,
        }
    source = pick_one(cwd, ".kicad_sch")
    if not source:
        return 1, {"ok": False, "message": "Select a single .kicad_sch or set schematic in .kicad-pcb.json"}
    with tempfile.TemporaryDirectory(prefix="kicad-pcb-erc-") as tmp:
        out = Path(tmp) / "erc.json"
        command = [cli, "sch", "erc", "--format", "json", "--output", str(out)]
        if cli_supports(cli, ["sch", "erc"], "--exit-code-violations"):
            command.append("--exit-code-violations")
        command.append(str(source))
        code, stdout, stderr = run(command, cwd)
        return code, {"ok": code == 0, "source": source.relative_to(cwd).as_posix(), "stdout": stdout, "stderr": stderr, "report": out.read_text() if out.exists() else ""}


def copy_export_artifacts(staging: Path, out: Path, artifacts: list[Path]) -> list[str]:
    out.mkdir(parents=True, exist_ok=True)
    copied = []
    for source in artifacts:
        if not source.exists() or not source.is_file():
            continue
        target = out / source.name
        shutil.copy2(source, target)
        copied.append(str(target))
    return copied


def zip_artifacts(zip_path: Path, artifacts: list[Path]) -> None:
    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as archive:
        for path in sorted(artifacts, key=lambda item: item.name):
            if path.exists() and path.is_file() and path != zip_path:
                archive.write(path, path.name)


def gerber_artifacts(path: Path) -> bool:
    suffix = path.suffix.lower()
    return suffix in {
        ".gbr",
        ".gtl",
        ".gbl",
        ".gts",
        ".gbs",
        ".gto",
        ".gbo",
        ".gtp",
        ".gbp",
        ".gta",
        ".gba",
        ".gm1",
        ".gko",
        ".drl",
    }


def export_gerbers(cwd: Path, out: Path) -> tuple[int, dict]:
    cli = kicad_cli()
    board = pick_one(cwd, ".kicad_pcb")
    if not cli:
        return 1, {"ok": False, "message": "kicad-cli is required"}
    if not board:
        return 1, {"ok": False, "message": "Select a single .kicad_pcb or set pcb in .kicad-pcb.json"}
    with tempfile.TemporaryDirectory(prefix="kicad-pcb-gerbers-") as tmp:
        staging = Path(tmp)
        output_dir = str(staging)
        if not output_dir.endswith(os.sep):
            output_dir += os.sep
        code1, stdout1, stderr1 = run([cli, "pcb", "export", "gerbers", "--output", output_dir, str(board)], cwd)
        code2, stdout2, stderr2 = run([cli, "pcb", "export", "drill", "--output", output_dir, str(board)], cwd)
        generated = [path for path in staging.iterdir() if path.is_file() and gerber_artifacts(path)]
        copied = copy_export_artifacts(staging, out, generated)
        zip_path = out / f"{board.stem}-gerbers.zip"
        zip_artifacts(zip_path, [Path(path) for path in copied])
    code = code1 or code2
    return code, {
        "ok": code == 0,
        "board": board.relative_to(cwd).as_posix(),
        "out": str(out),
        "zip": str(zip_path),
        "artifacts": copied,
        "stdout": stdout1 + stdout2,
        "stderr": stderr1 + stderr2,
    }


def convert_position_csv(source: Path, destination: Path) -> None:
    required = {"Ref", "PosX", "PosY", "Rot", "Side"}
    with source.open(newline="", encoding="utf-8") as src, destination.open("w", newline="", encoding="utf-8") as dst:
        reader = csv.DictReader(src)
        if reader.fieldnames is None or not required.issubset(reader.fieldnames):
            raise ValueError(f"Unexpected position CSV header: {reader.fieldnames!r}")
        writer = csv.writer(dst)
        writer.writerow(["Designator", "Mid X", "Mid Y", "Layer", "Rotation"])
        for row in reader:
            side = (row["Side"] or "").strip().lower()
            layer = "T" if side in {"top", "front"} else "B"
            writer.writerow([row["Ref"], row["PosX"], row["PosY"], layer, row["Rot"]])


def export_jlcpcb(cwd: Path, out: Path) -> tuple[int, dict]:
    cli = kicad_cli()
    board = pick_one(cwd, ".kicad_pcb")
    schematic = pick_one(cwd, ".kicad_sch")
    if not cli:
        return 1, {"ok": False, "message": "kicad-cli is required"}
    if not board:
        return 1, {"ok": False, "message": "Select a single .kicad_pcb or set pcb in .kicad-pcb.json"}
    if not schematic:
        return 1, {"ok": False, "message": "Select a single .kicad_sch or set schematic in .kicad-pcb.json"}
    with tempfile.TemporaryDirectory(prefix="kicad-pcb-jlcpcb-") as tmp:
        staging = Path(tmp)
        output_dir = str(staging)
        if not output_dir.endswith(os.sep):
            output_dir += os.sep
        code_g, stdout_g, stderr_g = run([cli, "pcb", "export", "gerbers", "--output", output_dir, str(board)], cwd)
        code_d, stdout_d, stderr_d = run([cli, "pcb", "export", "drill", "--output", output_dir, str(board)], cwd)
        bom = staging / f"BOM_{board.stem}.csv"
        code_b, stdout_b, stderr_b = run(
            [
                cli,
                "sch",
                "export",
                "bom",
                "--output",
                str(bom),
                "--fields",
                "Value,Reference,Footprint,LCSC",
                "--labels",
                "Comment,Designator,Footprint,LCSC Part #",
                "--sort-field",
                "Reference",
                "--exclude-dnp",
                str(schematic),
            ],
            cwd,
        )
        raw_pos = staging / f"CPL_kicad_{board.stem}.csv"
        cpl = staging / f"CPL_{board.stem}.csv"
        code_p, stdout_p, stderr_p = run(
            [
                cli,
                "pcb",
                "export",
                "pos",
                "--output",
                str(raw_pos),
                "--format",
                "csv",
                "--units",
                "mm",
                "--side",
                "both",
                "--exclude-dnp",
                str(board),
            ],
            cwd,
        )
        convert_error = ""
        if code_p == 0 and raw_pos.exists():
            try:
                convert_position_csv(raw_pos, cpl)
            except Exception as exc:
                code_p = 1
                convert_error = str(exc)
        generated = [path for path in staging.iterdir() if path.is_file() and (gerber_artifacts(path) or path in {bom, cpl})]
        copied = copy_export_artifacts(staging, out, generated)
        zip_path = out / f"{board.stem}-jlcpcb.zip"
        zip_artifacts(zip_path, [Path(path) for path in copied])
    code = code_g or code_d or code_b or code_p
    missing = []
    if not any(Path(path).name == bom.name for path in copied):
        missing.append("bom")
    if not any(Path(path).name == cpl.name for path in copied):
        missing.append("cpl")
    return code, {
        "ok": code == 0 and not missing,
        "board": board.relative_to(cwd).as_posix(),
        "schematic": schematic.relative_to(cwd).as_posix(),
        "out": str(out),
        "zip": str(zip_path),
        "artifacts": copied,
        "missing": missing,
        "stdout": stdout_g + stdout_d + stdout_b + stdout_p,
        "stderr": stderr_g + stderr_d + stderr_b + stderr_p + convert_error,
    }


def export_glb(cwd: Path, out: Path) -> tuple[int, dict]:
    cli = kicad_cli()
    board = pick_one(cwd, ".kicad_pcb")
    if not cli:
        return 1, {"ok": False, "message": "kicad-cli is required"}
    if not board:
        return 1, {"ok": False, "message": "Select a single .kicad_pcb or set pcb in .kicad-pcb.json"}
    if not cli_supports(cli, ["pcb", "export"], "glb"):
        return 1, {"ok": False, "message": "This kicad-cli does not support GLB export.", "tool": cli}
    out.parent.mkdir(parents=True, exist_ok=True)
    command = [
        cli,
        "pcb",
        "export",
        "glb",
        "--force",
        "--subst-models",
        "--include-tracks",
        "--include-pads",
        "--include-silkscreen",
        "--include-soldermask",
        "--output",
        str(out),
        str(board),
    ]
    code, stdout, stderr = run(command, cwd)
    return code, {"ok": code == 0, "board": board.relative_to(cwd).as_posix(), "out": str(out), "stdout": stdout, "stderr": stderr}


def artifact_href(path: str) -> str:
    return f"/api/kicad/file?path={quote(path)}&download=1"


def csv_asset_label(path: str) -> str:
    name = Path(path).name.lower()
    if "cpl" in name or "pos" in name or "position" in name:
        return "Assembly CPL"
    if "bom" in name:
        return "BOM"
    return "CSV"


def csv_header(path: Path) -> list[str]:
    try:
        with path.open(newline="") as handle:
            return next(csv.reader(handle), [])
    except Exception:
        return []


def csv_asset_role(cwd: Path, item: dict) -> str:
    name = Path(item["path"]).name.lower()
    header = [cell.strip().lower() for cell in csv_header(cwd / item["path"])]
    if "bom" in name or any("lcsc" in cell for cell in header):
        return "bom"
    if "cpl" in name or "pos" in name or "position" in name:
        return "assembly"
    if {"designator", "mid x", "mid y", "layer", "rotation"}.issubset(set(header)):
        return "assembly"
    return "csv"


def csv_asset_score(cwd: Path, item: dict) -> tuple[int, int, str]:
    name = Path(item["path"]).name.lower()
    header = [cell.strip().lower() for cell in csv_header(cwd / item["path"])]
    jlcpcb_cpl = {"designator", "mid x", "mid y", "layer", "rotation"}.issubset(set(header))
    lcsc_bom = any("lcsc" in cell for cell in header)
    score = 0
    if "jlcpcb" in item["path"].lower():
        score += 10
    if name.startswith("bom_") or "bom" in name:
        score += 8
    if jlcpcb_cpl:
        score += 8
    if lcsc_bom:
        score += 6
    if "kicad" in name:
        score -= 4
    return (score, -int(item.get("size") or 0), item["path"])


def csv_asset_link(item: dict, *, alternate: bool = False) -> str:
    path = item["path"]
    label = csv_asset_label(path)
    size = int(item.get("size") or 0)
    tag = "li" if alternate else "a"
    link = (
        "<a class='asset-download' "
        f"href='{html.escape(artifact_href(path), quote=True)}' "
        f"download='{html.escape(Path(path).name, quote=True)}'>"
        f"<span>{html.escape(label)}</span>"
        f"<code>{html.escape(path)}</code>"
        f"<small>{size:,} bytes</small>"
        "</a>"
    )
    return f"<{tag}>{link}</{tag}>" if alternate else link


def csv_assets(cwd: Path, items: list[dict]) -> str:
    if not items:
        return "<p class='muted'>No CSV BOM/CPL files found.</p>"
    by_role: dict[str, list[dict]] = {}
    for item in items:
        by_role.setdefault(csv_asset_role(cwd, item), []).append(item)
    primary = []
    alternates = []
    for role in ("bom", "assembly", "csv"):
        ranked = sorted(by_role.get(role, []), key=lambda item: csv_asset_score(cwd, item), reverse=True)
        if ranked:
            primary.append(ranked[0])
            alternates.extend(ranked[1:])
    html_parts = [f"<div class='asset-grid'>{''.join(csv_asset_link(item) for item in primary)}</div>"]
    if alternates:
        html_parts.append(
            "<details class='alternate-assets'><summary>Alternate CSVs</summary><ul>"
            + "".join(csv_asset_link(item, alternate=True) for item in alternates)
            + "</ul></details>"
        )
    return "".join(html_parts)


def is_lcsc_column(header: str) -> bool:
    normalized = re.sub(r"[^a-z0-9]+", "", header.lower())
    return "lcsc" in normalized


def lcsc_part_links(value: str) -> str:
    parts = re.findall(r"\bC\d+\b", value.strip(), re.IGNORECASE)
    if not parts:
        return html.escape(value)
    out = html.escape(value)
    for part in sorted(set(parts), key=len, reverse=True):
        escaped = html.escape(part)
        href = f"https://www.lcsc.com/search?q={quote(part.upper())}"
        out = re.sub(
            rf"\b{re.escape(escaped)}\b",
            f"<a href='{href}' target='_blank' rel='noopener noreferrer'>{escaped}</a>",
            out,
            flags=re.IGNORECASE,
        )
    return out


def csv_cell(header: str, value: str) -> str:
    if is_lcsc_column(header):
        return lcsc_part_links(value)
    return html.escape(value)


def csv_table(path: Path) -> str:
    if not path.exists():
        return "<p class='muted'>No CSV selected.</p>"
    try:
        rows = list(csv.reader(path.open(newline="")))
    except Exception as exc:
        return f"<p class='error'>{html.escape(str(exc))}</p>"
    if not rows:
        return "<p class='muted'>Empty CSV.</p>"
    headers = rows[0]
    head = "".join(f"<th>{html.escape(cell)}</th>" for cell in headers)
    body = "\n".join(
        "<tr>"
        + "".join(
            f"<td>{csv_cell(headers[index] if index < len(headers) else '', cell)}</td>"
            for index, cell in enumerate(row)
        )
        + "</tr>"
        for row in rows[1:200]
    )
    return f"<table><thead><tr>{head}</tr></thead><tbody>{body}</tbody></table>"


def file_list(items: list[dict] | None, empty: str) -> str:
    if not items:
        return f"<li class='muted'>{empty}</li>"
    return "".join(f"<li><code>{html.escape(item['path'])}</code></li>" for item in items)


def native_viewer(kind: str) -> str:
    return (
        f"<iframe class='native-viewer' data-kind='{html.escape(kind)}' "
        "src='/kicad-viewer/runtime.html'></iframe>"
    )


def model_viewer(kind: str, url: str) -> str:
    return (
        f"<iframe class='model-viewer' data-kind='{html.escape(kind)}' "
        f"data-url='{html.escape(url, quote=True)}' "
        "src='/kicad-viewer/runtime.html'></iframe>"
    )



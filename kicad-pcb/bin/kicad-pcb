const parseReport=(check)=>{{try{{return JSON.parse(check.report||"{{}}");}}catch{{return {{}};}}}};
const reportViolations=(kind, report)=>{{if(kind==="erc")return (report.sheets||[]).flatMap(sheet=>(sheet.violations||[]).map(v=>({{...v,sheet:sheet.path}})));return [...(report.violations||[]),...(report.schematic_parity||[]).map(v=>({{...v,type:v.type||"schematic_parity"}}))];}};
const renderCheck=(target, title, check, kind)=>{{const report=parseReport(check);const violations=reportViolations(kind,report);const counts=violations.reduce((acc,v)=>{{const s=v.severity||"unknown";acc[s]=(acc[s]||0)+1;return acc;}},{{}});const status=check.ok?"ok":violations.length?"error":"warning";const items=violations.map(v=>`<article class="issue"><div class="issue-head"><strong>${{esc(v.description||v.type||"Issue")}}</strong><span class="severity ${{esc(v.severity||"warning")}}">${{esc(v.severity||"warning")}}</span></div><div class="muted">${{esc(v.type||"")}}${{v.sheet?` · sheet ${{esc(v.sheet)}}`:""}}</div>${{(v.items||[]).length?`<ul class="items">${{v.items.map(item=>`<li>${{esc(item.description||item.uuid||"item")}}${{item.pos?` <span class="muted">(${{esc(item.pos.x)}}, ${{esc(item.pos.y)}})</span>`:""}}</li>`).join("")}}</ul>`:""}}</article>`).join("");target.innerHTML=`<div class="check-summary"><span class="pill ${{status}}">${{check.ok?"clean":"needs attention"}}</span><span class="pill">${{esc(report.kicad_version||"KiCad")}}</span><span class="pill">${{violations.length}} issue${{violations.length===1?"":"s"}}</span><span class="pill error">${{counts.error||0}} errors</span><span class="pill warning">${{counts.warning||0}} warnings</span></div><p class="muted">${{esc((check.stdout||check.message||"").split("\\n").filter(Boolean).slice(0,3).join(" · "))}}</p>${{items||"<p class='ok'>No issues reported.</p>"}}<details class="raw"><summary>Raw report</summary><pre>${{esc(JSON.stringify(check,null,2))}}</pre></details>`;}};
const loadChecks=()=>{{fetch("/api/kicad/drc").then(r=>r.json()).then(j=>renderCheck(drc,"DRC",j,"drc"));fetch("/api/kicad/erc").then(r=>r.json()).then(j=>renderCheck(erc,"ERC",j,"erc"));}};
const refreshPane=async()=>{{if(refreshInFlight)return;refreshInFlight=true;try{{const status=await fetch("/api/kicad/revision").then(r=>r.json());if(!sourceSnapshot||status.changed||status.revision!==sourceSnapshot.revision){{sourceSnapshot=undefined;const payload=await loadSources();document.querySelectorAll("iframe.native-viewer, iframe.model-viewer").forEach(frame=>void postSnapshot(frame));if(activeTab==="checks")loadChecks();}}}}catch(err){{console.warn("Backplane refresh failed",err);}}finally{{refreshInFlight=false;}}}};
const setTab=(id)=>{{activeTab=id;document.querySelectorAll("section").forEach(el=>el.classList.toggle("active",el.id===id));document.querySelectorAll(".tabs button").forEach(el=>el.classList.toggle("active",el.dataset.tab===id));location.hash=id;document.querySelectorAll(`#${{CSS.escape(id)}} iframe.native-viewer, #${{CSS.escape(id)}} iframe.model-viewer`).forEach(frame=>void postSnapshot(frame));if(id==="checks")loadChecks();}};
document.querySelectorAll(".tabs button").forEach(b=>b.onclick=()=>setTab(b.dataset.tab));setTab(location.hash.slice(1)||"schematic");
setInterval(refreshPane, 2500);
document.addEventListener("visibilitychange",()=>{{if(!document.hidden)void refreshPane();}});
</script></body></html>"""
    return body.encode()


class Server(BaseHTTPRequestHandler):
    cwd: Path
    session: str
    preloaded: dict
    preloaded_lock = threading.Lock()

    @classmethod
    def viewer_state(cls) -> dict:
        with cls.preloaded_lock:
            return cls.preloaded

    @classmethod
    def refresh_viewer_state(cls) -> dict:
        revision = current_source_revision(cls.cwd)
        with cls.preloaded_lock:
            if cls.preloaded.get("source_revision") == revision:
                return cls.preloaded
        refreshed = warm_viewer_state(cls.cwd)
        with cls.preloaded_lock:
            if cls.preloaded.get("source_revision") != refreshed.get("source_revision"):
                cls.preloaded = refreshed
            return cls.preloaded

    def log_message(self, fmt: str, *values: object) -> None:
        print("kicad-pcb:", fmt % values, file=sys.stderr)

    def send_bytes(
        self,
        data: bytes,
        content_type: str = "application/octet-stream",
        headers: dict[str, str] | None = None,
    ) -> None:
        self.send_response(200)
        self.send_header("content-type", content_type)
        self.send_header("content-length", str(len(data)))
        for key, value in (headers or {}).items():
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, body: object, status: int = 200) -> None:
        data = json.dumps(body, indent=2).encode()
        self.send_response(status)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        query = parse_qs(parsed.query)
        try:
            state = self.viewer_state()
            if parsed.path == "/healthz":
                self.send_json(
                    {
                        "ok": True,
                        "plugin": "kicad-pcb",
                        "kicad_cli": bool(kicad_cli()),
                        "preloaded": bool(state),
                        "source_revision": state.get("source_revision"),
                        "warmed_at_ms": state.get("warmed_at_ms"),
                    }
                )
            elif parsed.path in ("/api/project", "/api/kicad/manifest"):
                self.send_json(state.get("manifest") or manifest(self.cwd))
            elif parsed.path == "/api/kicad/revision":
                revision = current_source_revision(self.cwd)
                self.send_json(
                    {
                        "ok": True,
                        "revision": revision,
                        "changed": revision != state.get("source_revision"),
                        "warmed_revision": state.get("source_revision"),
                        "warmed_at_ms": state.get("warmed_at_ms"),
                    }
                )
            elif parsed.path == "/api/kicad/sources":
                state = self.refresh_viewer_state()
                self.send_json(
                    {
                        "ok": True,
                        "revision": state.get("source_revision"),
                        "sources": state.get("sources", []),
                        "warmed_at_ms": state.get("warmed_at_ms"),
                    }
                )
            elif parsed.path == "/api/kicad/file":
                target = safe_rel(self.cwd, query.get("path", [""])[0])
                headers = {}
                if query.get("download", [""])[0]:
                    headers["content-disposition"] = f'attachment; filename="{target.name}"'
                self.send_bytes(target.read_bytes(), mimetypes.guess_type(target.name)[0] or "text/plain", headers)
            elif parsed.path == "/api/kicad/model.glb":
                state = self.refresh_viewer_state()
                cached = state.get("model_path")
                target = Path(cached) if cached else None
                if not target or not target.exists():
                    with tempfile.TemporaryDirectory(prefix="kicad-pcb-glb-") as tmp:
                        fallback = Path(tmp) / "board.glb"
                        code, result = export_glb(self.cwd, fallback)
                        if code != 0 or not fallback.exists():
                            self.send_json(state.get("model_result") or result, 500)
                        else:
                            self.send_bytes(
                                fallback.read_bytes(),
                                "model/gltf-binary",
                                {"cache-control": "no-store, max-age=0", "pragma": "no-cache"},
                            )
                else:
                    self.send_bytes(
                        target.read_bytes(),
                        "model/gltf-binary",
                        {"cache-control": "public, max-age=31536000, immutable"},
                    )
            elif parsed.path == "/api/kicad/drc":
                self.send_json(run_check(self.cwd, "drc")[1])
            elif parsed.path == "/api/kicad/erc":
                self.send_json(run_check(self.cwd, "erc")[1])
            elif parsed.path.startswith("/kicad-viewer/"):
                target = (VIEWER_DIR / parsed.path.removeprefix("/kicad-viewer/")).resolve()
                target.relative_to(VIEWER_DIR)
                self.send_bytes(target.read_bytes(), mimetypes.guess_type(target.name)[0] or "application/octet-stream")
            elif parsed.path == "/":
                self.send_bytes(workbench_html(self.cwd, self.session, state), "text/html; charset=utf-8")
            else:
                self.send_json({"ok": False, "message": "not found"}, 404)
        except Exception as exc:
            self.send_json({"ok": False, "message": str(exc)}, 500)


def main(argv: list[str]) -> int:
    if not argv:
        return usage()
    cmd, rest = argv[0], argv[1:]
    if cmd == "setup":
        parser = argparse.ArgumentParser()
        parser.add_argument("--install-kicad", action="store_true")
        parser.add_argument("--install-kicad-tools", action="store_true")
        parser.add_argument("--kicad-tools-extra", default="agent")
        parser.add_argument("--force", action="store_true")
        parser.add_argument("--json", action="store_true")
        args = parser.parse_args(rest)
        result = {
            "ok": True,
            "viewer_assets": VIEWER_DIR.exists(),
            "viewer_asset_status": viewer_asset_status(),
            "runtime_dir": str(RUNTIME_DIR),
            "kicad_cli": kicad_cli(),
            "kicad_version": tool_version(kicad_cli()),
            "kct": kct_cli(),
            "kct_version": kct_version(),
        }
        if args.install_kicad:
            install = install_kicad_runtime(force=args.force)
            result["kicad_install"] = install
            result["ok"] = bool(install.get("ok"))
            result["kicad_cli"] = kicad_cli()
            result["kicad_version"] = tool_version(kicad_cli())
        if args.install_kicad_tools:
            install = install_kicad_tools_runtime(force=args.force, extra=args.kicad_tools_extra)
            result["kicad_tools_install"] = install
            result["ok"] = bool(result["ok"]) and bool(install.get("ok"))
            result["kct"] = kct_cli()
            result["kct_version"] = kct_version()
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            print("KiCad PCB plugin setup complete.")
            print(f"Bundled viewer assets: {'yes' if VIEWER_DIR.exists() else 'missing'}")
            print(f"Viewer asset drift: {result['viewer_asset_status'].get('ok')}")
            print(f"Runtime directory: {RUNTIME_DIR}")
            print(f"kicad-cli: {result['kicad_cli'] or 'missing'}")
            print(f"KiCad version: {result['kicad_version'] or 'unknown'}")
            print(f"kct: {result['kct'] or 'missing'}")
            print(f"kicad-tools version: {result['kct_version'] or 'unknown'}")
            if "kicad_install" in result:
                print(json.dumps(result["kicad_install"], indent=2))
            if "kicad_tools_install" in result:
                print(json.dumps(result["kicad_tools_install"], indent=2))
        return 0 if result["ok"] else 1
    if cmd == "doctor":
        cwd, as_json = parse_cwd(rest)
        result = {
            "ok": True,
            "cwd": str(cwd),
            "tools": {
                "python3": shutil.which("python3") is not None,
                "node": shutil.which("node") is not None,
                "kicad-cli": kicad_cli() is not None,
                "kikit": shutil.which("kikit") is not None,
                "kct": kct_cli() is not None,
            },
            "tool_paths": {
                "kicad-cli": kicad_cli(),
                "managed_kicad-cli": managed_kicad_cli(),
                "kct": kct_cli(),
                "managed_kct": managed_kct_cli(),
            },
            "versions": {
                "kicad": tool_version(kicad_cli()),
                "kicad-tools": kct_version(),
            },
            "runtime_dir": str(RUNTIME_DIR),
            "viewer_assets": VIEWER_DIR.exists(),
            "viewer_asset_status": viewer_asset_status(),
            "detected_files": [item["path"] for item in detect_files(cwd)][:200],
            "tabs": TABS,
        }
        print(json.dumps(result, indent=2) if as_json else result)
        return 0
    if cmd == "kct":
        cwd, as_json, pass_args = parse_passthrough(rest)
        tool = kct_cli()
        if not tool:
            result = {
                "ok": False,
                "message": "kicad-tools is required. Run `bin/kicad-pcb setup --install-kicad-tools`.",
                "tool": None,
            }
            print(json.dumps(result, indent=2))
            return 1
        if not pass_args:
            pass_args = ["--help"]
        code, stdout, stderr = run([tool, *pass_args], cwd)
        result = {
            "ok": code == 0,
            "tool": tool,
            "command": [tool, *pass_args],
            "cwd": str(cwd),
            "stdout": stdout,
            "stderr": stderr,
        }
        if as_json:
            print(json.dumps(result, indent=2))
        else:
            sys.stdout.write(stdout)
            sys.stderr.write(stderr)
        return code
    if cmd == "tool":
        cwd, as_json, pass_args = parse_passthrough(rest)
        if not pass_args:
            result = {
                "ok": False,
                "message": "Tool name required. Allowed tools: kct, kicad-cli, kikit.",
                "allowed_tools": ["kct", "kicad-cli", "kikit"],
            }
            print(json.dumps(result, indent=2))
            return 1
        requested, tool_args = pass_args[0], pass_args[1:]
        tool = resolve_tool(requested)
        if not tool:
            result = {
                "ok": False,
                "message": f"{requested} is not available or is not an allowed KiCad PCB tool.",
                "allowed_tools": ["kct", "kicad-cli", "kikit"],
            }
            print(json.dumps(result, indent=2))
            return 1
        if not tool_args:
            tool_args = ["--help"]
        code, stdout, stderr = run([tool, *tool_args], cwd)
        result = {
            "ok": code == 0,
            "tool": tool,
            "requested_tool": requested,
            "command": [tool, *tool_args],
            "cwd": str(cwd),
            "stdout": stdout,
            "stderr": stderr,
        }
        if as_json:
            print(json.dumps(result, indent=2))
        else:
            sys.stdout.write(stdout)
            sys.stderr.write(stderr)
        return code
    if cmd == "serve":
        parser = argparse.ArgumentParser()
        parser.add_argument("--port", type=int, required=True)
        parser.add_argument("--cwd", default=os.getcwd())
        parser.add_argument("--session", default="")
        args = parser.parse_args(rest)
        Server.cwd = Path(args.cwd).expanduser().resolve()
        Server.session = args.session
        Server.preloaded = warm_viewer_state(Server.cwd)
        ThreadingHTTPServer(("127.0.0.1", args.port), Server).serve_forever()
        return 0
    if cmd in ("drc", "erc"):
        cwd, as_json = parse_cwd(rest)
        code, result = run_check(cwd, cmd)
        print(json.dumps(result, indent=2) if as_json else result.get("message", json.dumps(result)))
        return code
    if cmd == "export":
        if not rest:
            return usage()
        sub, rest = rest[0], rest[1:]
        parser = argparse.ArgumentParser()
        parser.add_argument("--cwd", default=os.getcwd())
        parser.add_argument("--out", required=True)
        args = parser.parse_args(rest)
        if sub not in ("gerbers", "jlcpcb"):
            return usage()
        cwd = Path(args.cwd).expanduser().resolve()
        out = Path(args.out).expanduser().resolve()
        if sub == "jlcpcb":
            code, result = export_jlcpcb(cwd, out)
        else:
            code, result = export_gerbers(cwd, out)
        print(json.dumps(result, indent=2))
        return code
    return usage()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

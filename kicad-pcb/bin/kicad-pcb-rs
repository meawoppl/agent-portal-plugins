#!/usr/bin/env bash
# Agent Portal launcher for the Rust KiCad PCB runtime.
#
# Locates (and when needed builds) the Rust binary at .runtime/kicad-pcb-rs,
# then execs it with the given arguments. The binary is rebuilt with
# `cargo build --release -p kicad-pcb-server` whenever any crate source,
# Cargo manifest/lock, or embedded static asset is newer than the installed
# binary. Build logs go to stderr so `--json` stdout stays machine-readable.
#
# Python (bin/kicad-pcb) is only used for what Rust does not implement:
#   - `setup --install-kicad` (KiCad AppImage download/unpack), and
#   - a last-resort fallback when no binary exists and cargo is unavailable.
#
# Environment:
#   KICAD_PCB_RS_BIN      use this binary instead of .runtime/kicad-pcb-rs
#   KICAD_PCB_SKIP_BUILD  set to 1 to never build (use whatever binary exists)
#   CARGO                 cargo executable (default: PATH, then ~/.cargo/bin)
set -euo pipefail

PLUGIN_DIR="${AGENT_PORTAL_PLUGIN_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
RUNTIME_DIR="$PLUGIN_DIR/.runtime"
BIN="${KICAD_PCB_RS_BIN:-$RUNTIME_DIR/kicad-pcb-rs}"
PYTHON_RUNTIME="$PLUGIN_DIR/bin/kicad-pcb"

log() { printf 'kicad-pcb-rs: %s\n' "$*" >&2; }

find_cargo() {
  if [[ -n "${CARGO:-}" && -x "${CARGO}" ]]; then printf '%s\n' "$CARGO"; return 0; fi
  if command -v cargo >/dev/null 2>&1; then command -v cargo; return 0; fi
  if [[ -x "$HOME/.cargo/bin/cargo" ]]; then printf '%s\n' "$HOME/.cargo/bin/cargo"; return 0; fi
  return 1
}

stale() {
  [[ -x "$BIN" ]] || return 0
  [[ -f "$PLUGIN_DIR/Cargo.toml" ]] || return 1
  local newer
  newer="$(find "$PLUGIN_DIR/crates" "$PLUGIN_DIR/static" "$PLUGIN_DIR/Cargo.toml" "$PLUGIN_DIR/Cargo.lock" \
    -newer "$BIN" -type f -print -quit 2>/dev/null || true)"
  [[ -n "$newer" ]]
}

build() {
  local cargo
  if ! cargo="$(find_cargo)"; then
    return 1
  fi
  mkdir -p "$RUNTIME_DIR"
  (
    if command -v flock >/dev/null 2>&1; then
      exec 9>"$RUNTIME_DIR/.kicad-pcb-rs.build.lock"
      flock 9
    fi
    # Another launcher may have finished the build while we waited.
    stale || exit 0
    log "building Rust runtime with $cargo (release)"
    "$cargo" build --release -p kicad-pcb-server --manifest-path "$PLUGIN_DIR/Cargo.toml" 1>&2
    install -m 0755 "$PLUGIN_DIR/target/release/kicad-pcb-rs" "$BIN.tmp.$$"
    mv -f "$BIN.tmp.$$" "$BIN"
  )
}

ensure_binary() {
  if [[ -n "${KICAD_PCB_RS_BIN:-}" ]]; then
    [[ -x "$BIN" ]] || { log "KICAD_PCB_RS_BIN=$BIN is not executable"; return 1; }
    return 0
  fi
  if [[ "${KICAD_PCB_SKIP_BUILD:-0}" != "1" ]] && stale; then
    if ! build; then
      if [[ -x "$BIN" ]]; then
        log "sources are newer than $BIN but the build failed or cargo is missing; using the existing binary"
      else
        return 1
      fi
    fi
  fi
  [[ -x "$BIN" ]]
}

if [[ "${1:-}" == "setup" ]]; then
  shift
  install_kicad=0
  force=()
  rest=()
  for arg in "$@"; do
    case "$arg" in
      --install-kicad) install_kicad=1 ;;
      --force) force=(--force); rest+=("$arg") ;;
      *) rest+=("$arg") ;;
    esac
  done
  if [[ "$install_kicad" == "1" ]]; then
    # KiCad AppImage install is Python-only; keep its report off stdout.
    python3 "$PYTHON_RUNTIME" setup --install-kicad "${force[@]}" --json 1>&2
  fi
  if ! ensure_binary; then
    log "Rust runtime unavailable (no binary and no cargo); falling back to Python setup"
    exec python3 "$PYTHON_RUNTIME" setup "${rest[@]}"
  fi
  exec "$BIN" setup "${rest[@]}"
fi

if ! ensure_binary; then
  case "${1:-}" in
    serve|doctor|drc|erc|export|kct|tool)
      log "Rust runtime unavailable (no binary and no cargo); falling back to the Python runtime"
      exec python3 "$PYTHON_RUNTIME" "$@"
      ;;
    *)
      log "Rust runtime unavailable and '${1:-}' has no Python fallback. Install Rust (https://rustup.rs) or set KICAD_PCB_RS_BIN."
      exit 1
      ;;
  esac
fi
exec "$BIN" "$@"
